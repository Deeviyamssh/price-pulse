# ============================================
# Database Configuration
# ============================================
# PostgreSQL database password (required)
POSTGRES_PASSWORD=pricepulse-local-password

# ============================================
# Security Configuration
# ============================================
# JWT secret key for token signing (required, min 32 characters)
# Generate a strong random secret for production
JWT_SECRET=pricepulse-local-jwt-secret-at-least-32-characters

# ============================================
# Scheduler Configuration
# ============================================
# Price check interval in milliseconds (optional, default: 1800000 = 30 minutes)
SCHEDULER_INTERVAL_MS=1800000

# ============================================
# Email Configuration (Production Only)
# ============================================
# SMTP server host (required for production, optional for dev with Mailhog)
SPRING_MAIL_HOST=smtp.example.com
# SMTP server port (optional, default: 587 for TLS, 465 for SSL)
SPRING_MAIL_PORT=587
# SMTP username (required for production)
SPRING_MAIL_USERNAME=your-email@example.com
# SMTP password (required for production)
SPRING_MAIL_PASSWORD=your-smtp-password
